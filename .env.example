# Copy this file to .env and fill in your own values.

# Supabase — public, safe to expose in the browser bundle (used by src/lib/supabase.ts)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI chatbot (api/chat.ts) — SERVER-SIDE ONLY, set these in Vercel project settings, ---
# --- never with a VITE_ prefix, or they'd be bundled into the browser. ---

# Service role key: bypasses Row Level Security. Only ever read inside api/chat.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
